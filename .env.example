# Database
DB_NAME=nexaworkspace
DB_USER=nexa
DB_PASSWORD=change-me

# Security
JWT_SECRET=generate-a-long-random-secret

# Billing: sandbox (default) or live
BILLING_MODE=sandbox
FRONTEND_URL=http://localhost:3000

# Stripe (required only when BILLING_MODE=live and provider=STRIPE)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Mercado Pago (required only when BILLING_MODE=live and provider=MERCADO_PAGO)
MERCADO_PAGO_ACCESS_TOKEN=
MP_PRO_MONTHLY_BRL=49.90
MP_BUSINESS_MONTHLY_BRL=149.90

# Grafana local credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
